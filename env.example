# Copy to .env, edit the settings, and source it from the repository root.

# Trainable skill optimizer, initialized once and updated across all phases.
# Replace every model placeholder with your own checkpoint or service model ID.
export BASE_MODEL="/path/to/models/skill-optimizer"

# Initial training data and data generated between phases.
export WER_DATA_DIR="${PWD}/extra_datasets"
export TRAIN_FILE="${WER_DATA_DIR}/origin/train.parquet"

# Experiment name and training outputs.
export PROJECT_NAME="wer_training"
export EXPERIMENT_NAME="wer_run"
export OUTPUT_DIR="${PWD}/outputs/${EXPERIMENT_NAME}"

# Training hardware. Use cuda for an NVIDIA training environment.
export TRAIN_DEVICE="npu"
export N_GPUS_PER_NODE=6
export NNODES=1
# Ascend only; match this list to the device count.
export ASCEND_RT_VISIBLE_DEVICES="0,1,2,3,4,5"

# OpenAI-compatible task executor used to compute training rewards.
# The model name must match the name exposed by the service.
export WER_EXECUTOR_BASE_URL="http://localhost:8000/v1"
export WER_EXECUTOR_MODEL="executor-model"
export WER_EXECUTOR_API_KEY="EMPTY"

# Tau2 tasks only: frozen agent and user simulator, reused across all phases.
# The openai/ prefix selects the OpenAI-compatible LiteLLM interface.
export TAU2_AGENT_MODEL="openai/${WER_EXECUTOR_MODEL}"
export TAU2_AGENT_API_BASE="${WER_EXECUTOR_BASE_URL}"
export TAU2_AGENT_API_KEY="${WER_EXECUTOR_API_KEY}"
export TAU2_USER_MODEL="openai/user-simulator-model"
export TAU2_USER_API_KEY=""
# Set the endpoint for the user-simulator service.
export TAU2_USER_API_BASE="https://your-provider.example/v1"

# Optional overrides; otherwise the launcher and reward modules use defaults.
# export LOCAL_MODEL_PATH="${BASE_MODEL}"
# export TOKENIZER_MODEL_PATH="${BASE_MODEL}"
# export BFCL_PROJECT_ROOT="${OUTPUT_DIR}/reward"
# export TAU2_DATA_DIR="${PWD}/verl/tau2-bench-verified/data"
# export BFCL_INITIAL_CONTEXT_QUERY_PATH="/path/to/data/bfcl_initial_context_query.jsonl"
# export TAU2_INITIAL_CONTEXT_QUERY_PATH="/path/to/data/tau2_initial_context_query.jsonl"
# export VLLM_USE_V1=1
# export VLLM_ATTENTION_BACKEND="XFORMERS"
